# BASTION Environment Configuration
# Copy this file to .env.local (frontend) and backend/.env and fill in values
# DO NOT commit files with real credentials

# ===========================================
# Frontend Configuration (./frontend/.env.local)
# ===========================================

# Privy Authentication
# Get your App ID from https://dashboard.privy.io
VITE_PRIVY_APP_ID=your_privy_app_id_here

# NEAR Configuration
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC=https://rpc.testnet.near.org

# Pinata IPFS Configuration
# Get your JWT from https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=your_pinata_jwt_here
# Optional: Use dedicated gateway for production
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# Backend API URL
VITE_BACKEND_URL=http://localhost:3001

# ===========================================
# Backend Configuration (./backend/.env)
# ===========================================

# Server
PORT=3002
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/coalition_ops

# IPFS (Pinata)
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://your-gateway.mypinata.cloud

# NEAR Configuration
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com

# NEAR Funding Contract (Phase 1.3)
# Deploy funding-contract WASM to testnet and set the contract ID here
# See near-contracts/funding-contract/README.md for deployment instructions
NEAR_FUNDING_CONTRACT_ID=funding.YOUR_TESTNET_ACCOUNT.testnet

# Backend NEAR Account for calling funding contract
# This account must be authorized in the funding contract (via add_authorized call)
# Generate key with: near generate-key backend-funding.YOUR_TESTNET_ACCOUNT.testnet
NEAR_BACKEND_ACCOUNT_ID=backend-funding.YOUR_TESTNET_ACCOUNT.testnet
NEAR_BACKEND_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE

# DID Registry and Credential Registry contracts
# Signing accounts call these contracts to store DID documents and anchor credentials
DID_CONTRACT_ID=did-registry.testnet
CREDENTIAL_CONTRACT_ID=credential-registry.testnet

# DID secret seed for deterministic user secret derivation
# CRITICAL: Must be consistent across deploys — changing this orphans existing DIDs
# Generate with: openssl rand -hex 32
DID_SECRET_SEED=generate_with_openssl_rand

# FastNEAR API (optional, for enhanced RPC)
FASTNEAR_API_KEY=your_fastnear_api_key_here

# Encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand

# ===========================================
# Docker Compose (overrides)
# ===========================================

# These are set in docker-compose.yml, but can be overridden:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=coalition_ops
