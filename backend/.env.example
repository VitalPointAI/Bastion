PINATA_JWT=your_pinata_jwt_here
FASTNEAR_API_KEY=your_fastnear_api_key_here
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
PINATA_GATEWAY=https://your-gateway.mypinata.cloud
PORT=3002
NODE_ENV=development

# AWS SES Configuration
# Leave blank for development mode (emails logged to console)
# SES must be configured with verified sending domain/email.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
FROM_EMAIL=noreply@bastion.ai
APP_URL=http://localhost:5173
