[Unit]
Description=Bastion Robot Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vitalpoint
WorkingDirectory=/home/vitalpoint/projects/bastion/robot
Environment=PATH=/home/vitalpoint/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/vitalpoint/projects/sphero-sdk-raspberrypi-python
ExecStart=/usr/bin/python3 mission_client.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
