BASTION_WS_URL=ws://192.168.1.100:3001
ROBOT_ID=alpha
AUTH_TOKEN=demo-token
SERIAL_PORT=/dev/ttyTHS1
CALIBRATION_PROFILE=default
SIMULATE=true

# ---------------------------------------------------------------------------
# DID-based authentication (replaces AUTH_TOKEN)
# ---------------------------------------------------------------------------
# REGISTRATION_TOKEN=              # One-time token for first-time registration
# ROBOT_DID=                       # Persisted DID from prior registration
# DID_FILE=.robot_did              # File path to persist the DID

# ---------------------------------------------------------------------------
# Bridge connectivity (mDNS discovery + manual fallback)
# ---------------------------------------------------------------------------
# BRIDGE_HOST=                     # Manual fallback bridge IP or hostname
# BRIDGE_PORT=8765                 # Bridge relay WebSocket port
# MDNS_BROWSE_TIMEOUT_SEC=10.0    # mDNS discovery timeout in seconds

# ---------------------------------------------------------------------------
# Vision Configuration (Phase 44)
# ---------------------------------------------------------------------------
# VISION_ENABLED=true              # Enable camera and vision engine
# VISION_MODEL=ssd-mobilenet-v2   # detectNet model name
# VISION_THRESHOLD=0.5             # Minimum detection confidence (0.0-1.0)
# CAMERA_SENSOR_ID=0              # CSI camera sensor ID
# KEYFRAME_ENABLED=false           # Send JPEG key frames on detection events
# KEYFRAME_JPEG_QUALITY=50        # JPEG quality (0-100)
# KEYFRAME_RESOLUTION=640x480     # Downsampled resolution for key frames
# VISION_VLM_ENABLED=false        # Enable VLM scene description (heavy)
# VISION_CADENCE_MS=500            # Vision detection loop interval in ms

# ---------------------------------------------------------------------------
# Intent Translation (Phase 44)
# ---------------------------------------------------------------------------
# INTENT_LLM_ENABLED=false         # Use cloud LLM for intent translation
# OPENAI_API_KEY=                  # OpenAI API key (for cloud intent)
# ANTHROPIC_API_KEY=               # Anthropic API key (alternative)

# ---------------------------------------------------------------------------
# Robot Authority Settings (Phase 44)
# ---------------------------------------------------------------------------
# ROBOT_AUTONOMY_LEVEL=1           # Authorized autonomy level (1-5, default 1 = safest)

# ---------------------------------------------------------------------------
# Swarm Coordination (Phase 46)
# ---------------------------------------------------------------------------
# SWARM_ENABLED=false               # Enable swarm coordinator at startup
# SWARM_ROLE=auto                   # Swarm role: 'leader', 'follower', or 'auto' (leader if vision-equipped)
