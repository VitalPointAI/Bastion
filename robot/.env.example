BASTION_WS_URL=ws://192.168.1.100:3001
ROBOT_ID=alpha
AUTH_TOKEN=demo-token
SERIAL_PORT=/dev/ttyTHS1
CALIBRATION_PROFILE=default
SIMULATE=true

