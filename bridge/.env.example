# -------------------------------------------------------
# Bridge Service Environment Configuration
# Copy this file to .env and fill in the required values.
# -------------------------------------------------------

# --- REQUIRED ---

# WebSocket URL of the Bastion cloud backend
# Example: wss://bastion.example.com
CLOUD_WS_URL=wss://bastion.example.com

# Unique identifier for this bridge instance (e.g., hostname or custom label)
BRIDGE_ID=my-bridge-01

# --- OPTIONAL ---

# One-time registration token (used on first connect to obtain DID)
# Leave empty if the bridge already has a persisted DID
REGISTRATION_TOKEN=

# Persisted DID (populated automatically after first registration)
BRIDGE_DID=

# Path to the file where the bridge DID is persisted
DID_FILE=.bridge_did

# Local port for the robot WebSocket relay server
RELAY_PORT=8765

# Local port for the optional browser UI
UI_PORT=8766

# How often (seconds) to run a full LAN scan
SCAN_INTERVAL_SEC=60

# How long (seconds) to browse mDNS services during each scan
SCAN_DURATION_SEC=30

# TTL (seconds) for queued commands awaiting offline robots
COMMAND_TTL_SEC=300

# Initial reconnect delay (seconds) for exponential backoff
RECONNECT_INITIAL_DELAY=5.0

# Maximum reconnect delay (seconds)
RECONNECT_MAX_DELAY=60.0

# How long (seconds) to browse mDNS for robot discovery
MDNS_BROWSE_TIMEOUT_SEC=10.0

# Set to "true" to enable the built-in browser UI (plan 05)
ENABLE_UI=false
